/*
================================================================================
PRODUCTION DAX PATTERNS: SEMANTIC MODEL OPTIMIZATION
Author: Sai Lakshmi Elusuri
Target: VertiPaq Storage Engine (SE) Batch Maximization & Safe Calculation Groups
Tooling: Tabular Editor 3 (TMDL / C# Scripting) / DAX Studio / Power BI Desktop
================================================================================
*/

--------------------------------------------------------------------------------
-- 1. CALCULATION GROUP: TIME INTELLIGENCE (Precedence = 20)
-- Eliminates measure sprawl across core KPIs while protecting SE batch scans.
-- Dim_Date joins to Fact tables on integer DateKey (YYYYMMDD) for dictionary
-- compression; Dim_Date[Date] (marked as Date Table) drives time intelligence.
--------------------------------------------------------------------------------
CALCULATION GROUP 'Time Intelligence'[Period] (Precedence = 20)

  CALCULATION ITEM "Current Period" =
    SELECTEDMEASURE()

  CALCULATION ITEM "YTD" =
    CALCULATE(
        SELECTEDMEASURE(),
        DATESYTD('Dim_Date'[Date])
    )

  CALCULATION ITEM "Working Days YTD" =
    CALCULATE(
        SELECTEDMEASURE(),
        DATESYTD('Dim_Date'[Date]),
        KEEPFILTERS('Dim_Date'[IsWorkingDay] = TRUE)
    )

  CALCULATION ITEM "Prior Year (PY)" =
    CALCULATE(
        SELECTEDMEASURE(),
        SAMEPERIODLASTYEAR('Dim_Date'[Date])
    )

  CALCULATION ITEM "YoY Growth %" =
    VAR _Current = SELECTEDMEASURE()
    VAR _Prior = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Dim_Date'[Date]))
    RETURN
        DIVIDE(_Current - _Prior, _Prior, BLANK())
    -- Dynamic Format String Expression: "0.0%;-0.0%;0.0%"

--------------------------------------------------------------------------------
-- 2. CALCULATION GROUP: DAILY-GRAIN MULTI-CURRENCY CONVERSION (Precedence = 10)
-- Fixes two common anti-patterns:
--   (a) Translates at Dim_Date[DateKey] grain via SUMX instead of multiplying
--       an entire period by a single MAX(DateKey) spot rate.
--   (b) Guards ratio/percentage measures from being multiplied by FX rates,
--       and returns BLANK() (never a silent 1.0 fallback) if an FX rate is missing.
--------------------------------------------------------------------------------
CALCULATION GROUP 'Currency'[Selected Currency] (Precedence = 10)

  CALCULATION ITEM "EUR (Base)" =
    SELECTEDMEASURE()

  CALCULATION ITEM "USD" =
    IF(
        ISSELECTEDMEASURE([YoY Growth %], [Gross Margin %], [SLA Compliance %]),
        SELECTEDMEASURE(),
        SUMX(
            VALUES('Dim_Date'[DateKey]),
            VAR _DailyRate =
                LOOKUPVALUE(
                    'Fact_Exchange_Rates'[RateToUSD],
                    'Fact_Exchange_Rates'[DateKey],
                    'Dim_Date'[DateKey]
                )
            RETURN
                IF(ISBLANK(_DailyRate), BLANK(), SELECTEDMEASURE() * _DailyRate)
        )
    )

--------------------------------------------------------------------------------
-- 3. SEMI-ADDITIVE MEASURE (CLOSING SNAPSHOT BALANCE)
-- Avoids redundant CALCULATE(MAX(...)) wrappers; filters Fact snapshot cleanly
-- on integer DateKey via KEEPFILTERS to preserve Storage Engine vector scans.
--------------------------------------------------------------------------------
[Closing Inventory Value] =
VAR _LastSnapshotDateKey = MAX('Fact_Inventory_Snapshot'[SnapshotDateKey])
RETURN
    CALCULATE(
        SUM('Fact_Inventory_Snapshot'[EndingValuation_EUR]),
        KEEPFILTERS('Dim_Date'[DateKey] = _LastSnapshotDateKey)
    )

--------------------------------------------------------------------------------
-- 4. VERTIPAQ APPLES-TO-APPLES BENCHMARK: FE TABLE ITERATION VS. SE COLUMN FILTER
-- Both expressions return identical results under any visual filter context.
-- The slow version forces Formula Engine materialization over the full fact
-- table; the tuned version pushes a single column bitmap filter into SE.
--------------------------------------------------------------------------------
[Revenue Delivered (Slow - FE Scan)] =
CALCULATE(
    SUM('Fact_Sales'[Revenue_EUR]),
    FILTER('Fact_Sales', 'Fact_Sales'[StatusCode] = "DELIVERED")
)

[Revenue Delivered (Tuned - SE Vector Scan)] =
CALCULATE(
    [Total Revenue],
    KEEPFILTERS('Fact_Sales'[StatusCode] = "DELIVERED")
)
